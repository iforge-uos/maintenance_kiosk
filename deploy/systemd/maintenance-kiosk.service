[Unit]
Description=Print Farm Maintenance Kiosk web app
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@KIOSK_USER@
WorkingDirectory=/opt/maintenance-kiosk/current
Environment=KIOSK_DATA_DIR=/var/lib/maintenance-kiosk
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/maintenance-kiosk/current/.venv/bin/python -m gunicorn --bind 127.0.0.1:5000 --workers 1 --threads 2 --timeout 120 --no-control-socket kiosk:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
